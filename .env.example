# Never commit the real token or a production password.
PORT=3000
NODE_ENV=production
DATA_DIR=./data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
APIFY_TOKEN=apify_api_your_token
APIFY_ACTOR=apify/instagram-scraper
# 6 hours. Set to 0 to disable automatic polling.
SYNC_INTERVAL_MS=21600000
